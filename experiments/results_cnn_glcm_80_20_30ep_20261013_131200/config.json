{
  "experiment_name": "Bonn EEG GLCM-CNN Controlled M1 Mac Training",
  "protocol": "Stratified 80:20 Outer Split with 10% Inner Validation of Training Pool",
  "random_seed": 42,
  "hardware": {
    "device": "mps",
    "machine": "MacBook Air M1 (8 GB RAM)",
    "pytorch_version": "2.12.0",
    "python_version": "3.13.9"
  },
  "cnn_architecture": {
    "model_name": "BonnGLCMCNN",
    "input_shape": [8, 16, 16],
    "conv_blocks": [
      {"block": 1, "in_channels": 8, "out_channels": 16, "kernel": 3, "stride": 1, "padding": 1, "pool": [2, 2]},
      {"block": 2, "in_channels": 16, "out_channels": 32, "kernel": 3, "stride": 1, "padding": 1, "pool": [2, 2]},
      {"block": 3, "in_channels": 32, "out_channels": 64, "kernel": 3, "stride": 1, "padding": 1, "pool": [2, 2]}
    ],
    "head": "AdaptiveAvgPool2D(1, 1) -> Dense(64, ReLU) -> Dropout(0.4) -> Dense(num_classes)"
  },
  "training_hyperparameters": {
    "optimizer": "AdamW",
    "learning_rate": 0.005,
    "weight_decay": 0.0001,
    "batch_size": 16,
    "max_epochs": 30,
    "loss": "Weighted Cross-Entropy (weights computed strictly on gradient-training subset)",
    "scheduler": {
      "type": "ReduceLROnPlateau",
      "mode": "max",
      "factor": 0.5,
      "patience": 4,
      "min_lr": 1e-6
    },
    "early_stopping": {
      "monitor": "val_accuracy",
      "patience": 5,
      "mode": "strict improvement (ties keep first best)",
      "restore_best_weights": true
    }
  },
  "cases": {
    "Case1_3Class": {
      "classes": {"0": "A", "1": "B", "2": "C+D"},
      "total_samples": 400,
      "train_samples": 288,
      "val_samples": 32,
      "test_samples": 80
    },
    "Case2_Binary": {
      "classes": {"0": "A+B+C+D (non-ictal)", "1": "E (ictal)"},
      "total_samples": 500,
      "train_samples": 360,
      "val_samples": 40,
      "test_samples": 100
    },
    "Case3_Binary": {
      "classes": {"0": "D (interictal)", "1": "E (ictal)"},
      "total_samples": 200,
      "train_samples": 144,
      "val_samples": 16,
      "test_samples": 40
    }
  }
}
